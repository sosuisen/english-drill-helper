<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.sosuisha</groupId>
  <artifactId>english-drill-player</artifactId>
  <version>1.0-SNAPSHOT</version>
  <description>English Drill Player - a desktop player for English drills</description>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.plugin.version>0.0.8</javafx.plugin.version>
    <javafx.version>26.0.2</javafx.version>
    <javafx.builder.version>26.0.0</javafx.builder.version>
    <maven.compiler.release>25</maven.compiler.release>
    <main.class>com.sosuisha.main.Launcher</main.class>
    <atlantafx.version>2.1.0</atlantafx.version>
    <jspecify.version>1.0.1</jspecify.version>
    <errorprone.version>2.50.0</errorprone.version>
    <nullaway.version>0.14.0</nullaway.version>
    <junit.version>6.1.3</junit.version>
    <jooq.version>3.21.7</jooq.version>
    <sqlite.jdbc.version>3.53.2.1</sqlite.jdbc.version>
    <javasound.mp3.version>1.9.8</javasound.mp3.version>
    <ikonli.version>12.4.0</ikonli.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.sosuisen</groupId>
      <artifactId>javafx-builder-controls</artifactId>
      <version>${javafx.builder.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.sosuisen</groupId>
      <artifactId>javafx-builder-graphics</artifactId>
      <version>${javafx.builder.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
      <version>${atlantafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jooq</groupId>
      <artifactId>jooq</artifactId>
      <version>${jooq.version}</version>
    </dependency>
    <dependency>
      <!-- mp3 decoder for the Java Sound API, found through its SPI at runtime.
           The code never refers to its classes (see ADR 001). -->
      <groupId>com.tianscar.javasound</groupId>
      <artifactId>javasound-mp3</artifactId>
      <version>${javasound.mp3.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-javafx</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <!-- Material Design 2 icons, the set the AtlantaFX samples use. -->
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-material2-pack</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <!-- Compile time only. jOOQ classes such as org.jooq.conf.Settings carry
           JAXB annotations, and javac warns about them when the JAXB API is
           missing. jOOQ itself does not need it at runtime here. -->
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.5</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <!-- Required by Error Prone. Error Prone needs access to javac
                 internals; the add-exports options are in .mvn/jvm.config. -->
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <!-- Only NullAway runs. The built-in Error Prone checks are off.
                 The javac plugin arguments must be one argument. -->
            <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:AnnotatedPackages=com.sosuisha -XepOpt:NullAway:TreatGeneratedAsUnannotated=true -XepOpt:NullAway:CustomInitializerAnnotations=org.testfx.framework.junit5.Start</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <!-- Test classes run in parallel across forked JVMs. TestFX needs
               one JavaFX toolkit per JVM, so in-JVM parallelism is not safe. -->
          <forkCount>1C</forkCount>
          <reuseForks>true</reuseForks>
          <systemPropertyVariables>
            <!-- Runs the TestFX tests without opening windows. -->
            <glass.platform>Headless</glass.platform>
            <!-- StageStyle.EXTENDED and HeaderBar are preview features in JavaFX 26. -->
            <javafx.enablePreview>true</javafx.enablePreview>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jooq</groupId>
        <artifactId>jooq-codegen-maven</artifactId>
        <version>${jooq.version}</version>
        <executions>
          <execution>
            <id>generate-jooq</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-meta-extensions</artifactId>
            <version>${jooq.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <generator>
            <database>
              <name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
              <properties>
                <property>
                  <key>scripts</key>
                  <value>src/main/resources/db/schema.sql</value>
                </property>
                <property>
                  <key>defaultNameCase</key>
                  <value>lower</value>
                </property>
              </properties>
            </database>
            <generate>
              <!-- @Generated lets NullAway skip the generated classes. -->
              <generatedAnnotation>true</generatedAnnotation>
              <generatedAnnotationType>DETECT_FROM_JDK</generatedAnnotationType>
              <generatedAnnotationDate>false</generatedAnnotationDate>
            </generate>
            <target>
              <packageName>com.sosuisha.db</packageName>
              <directory>target/generated-sources/jooq</directory>
            </target>
          </generator>
        </configuration>
      </plugin>
      <plugin>
        <groupId>net.revelc.code.formatter</groupId>
        <artifactId>formatter-maven-plugin</artifactId>
        <version>2.29.0</version>
        <configuration>
          <configFile>${project.basedir}/styles_for_jfxbuilder.xml</configFile>
          <lineEnding>LF</lineEnding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/app/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx.plugin.version}</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <options>
            <!-- StageStyle.EXTENDED and HeaderBar are preview features in JavaFX 26. -->
            <option>-Djavafx.enablePreview=true</option>
          </options>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <outputDirectory>${project.build.directory}/app</outputDirectory>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.8.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <name>english-drill-player</name>
          <appVersion>1.0.0</appVersion>
          <vendor>${project.groupId}</vendor>
          <input>${project.build.directory}/app/</input>
          <mainJar>${project.artifactId}-${project.version}.jar</mainJar>
          <destination>${project.build.directory}/jpackage</destination>
          <javaOptions>
            <option>-Dfile.encoding=UTF-8</option>
            <!-- StageStyle.EXTENDED and HeaderBar are preview features in JavaFX 26. -->
            <option>-Djavafx.enablePreview=true</option>
          </javaOptions>
          <type>${jpackage.type}</type>
          <icon>${jpackage.icon}</icon>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>win</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <!-- APP_IMAGE or MSI -->
        <!-- If you choose MSI, install WiX and set the path -->
        <jpackage.type>APP_IMAGE</jpackage.type>
        <jpackage.icon>${project.basedir}/images/icon.ico</jpackage.icon>
      </properties>
      <build>
        <plugins>
          <!-- jpackage generates read-only exe on Windows, which causes maven-clean-plugin to fail.
               Remove the read-only attribute after jpackage execution so that mvn clean works. -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>remove-readonly</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>attrib</executable>
                  <arguments>
                    <argument>-R</argument>
                    <argument>/S</argument>
                    <argument>${project.build.directory}\jpackage\*.*</argument>
                  </arguments>
                  <successCodes>
                    <successCode>0</successCode>
                    <successCode>1</successCode>
                  </successCodes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <!-- DMG or PKG -->
        <jpackage.type>DMG</jpackage.type>
        <jpackage.icon>${project.basedir}/images/icon.icns</jpackage.icon>
      </properties>
    </profile>
    <profile>
      <id>unix</id>
      <activation>
        <os>
          <family>unix</family>
        </os>
      </activation>
      <properties>
        <!-- APP_IMAGE, RPM or DEB -->
        <jpackage.type>APP_IMAGE</jpackage.type>
        <jpackage.icon>${project.basedir}/images/icon.png</jpackage.icon>
      </properties>
    </profile>
  </profiles>
</project>
